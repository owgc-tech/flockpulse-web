# Supabase project credentials — available in the Supabase dashboard under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Absolute origin of this deployment — used to build redirectTo URLs in auth emails
# (invite links, password-reset links). Must not have a trailing slash.
# Local dev: http://localhost:3000
# Deployed:  https://<your-vercel-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
